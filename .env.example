# Leave the Supabase vars unset to run on local browser storage (no account needed).
# Set both to switch the whole app over to Supabase — nothing else changes.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin passcode at #/admin, used in BOTH modes. Checked in the browser, so it
# keeps casual visitors out of the panel — it does not protect the database.
VITE_ADMIN_PASSCODE=salinas
